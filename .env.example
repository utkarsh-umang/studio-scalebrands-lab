# Monorepo env — copy to .env and fill in values
# Run: cp .env.example .env
#
# Backend (FastAPI) reads these when started via Task or uvicorn

# ── App ──
ENVIRONMENT=local
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
API_V1_STR=/api/v1

# ── Auth bootstrap (B0 seed) ──
# First admin is created by the seed script if no admin exists — not via a public signup API.
BOOTSTRAP_ADMIN_EMAIL=admin@scalebrandslab.demo
BOOTSTRAP_ADMIN_PASSWORD=change-me-local-only
BOOTSTRAP_ADMIN_DISPLAY_NAME=Studio Admin
# When true, also seeds demo client/editor/smm/admin accounts (password demo1234) for local QA
SEED_DEMO_USERS=true
# Local UI review only: adds one stable batch at every canonical workflow stage.
SEED_VISUAL_REVIEW_SCENARIOS=false

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# ── Redis ──
REDIS_HOST=localhost
# When Redis runs via docker-compose, it maps to host port 16379 by default (see REDIS_PUBLISH_PORT).
# Use 16379 here for backend-on-host + compose Redis. Full stack in Docker ignores this (uses redis:6379).
REDIS_PORT=16379
# REDIS_PASSWORD=

# Docker compose only: host port published for Redis (default 16379 avoids clashing with a local Redis on 6379)
# REDIS_PUBLISH_PORT=16379

# ── GCP (optional, prod only) ──
# GCP_PROJECT_ID=
# GCP_SECRET_NAME=

# ── Google Drive (manifest script only) ──
# Path to service account JSON — share each batch folder with the SA email as Viewer.
# Used by: npm run drive:sync-manifests. (The QA modal embeds Drive's /preview iframe
# directly, so the backend no longer needs Drive credentials.)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=backend-app/secrets/your-service-account.json
